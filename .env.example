# Copie para .env.local (dev) e configure as mesmas variáveis na Vercel.
# Variáveis VITE_* vão para o navegador: só chaves públicas aqui.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID_FOR_ME=
VITE_EMAILJS_TEMPLATE_ID_FOR_SENDER=
VITE_EMAILJS_PUBLIC_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_LASTFM_API_KEY=

# Só servidor (Vercel Functions em /api). Nunca use prefixo VITE_ nelas.
GITHUB_TOKEN=
WAKATIME_API_KEY=

# Spotify "tocando agora" (só servidor). Gere o refresh token com: node scripts/spotify-auth.mjs
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
